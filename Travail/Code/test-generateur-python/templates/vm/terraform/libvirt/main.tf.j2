terraform {
  required_version = ">= 1.5.0"
  required_providers {
    libvirt = {
      source  = "dmacvicar/libvirt"
      version = "~> 0.7"
    }
  }
}

provider "libvirt" {
  uri = var.libvirt_uri
}

resource "libvirt_pool" "app" {
  name = "${var.app_name}-${var.environment}-pool"
  type = "dir"
  path = "/var/lib/libvirt/images/${var.app_name}-${var.environment}"
}

resource "libvirt_volume" "os" {
  name   = "${var.app_name}-${var.environment}-os.qcow2"
  pool   = libvirt_pool.app.name
  source = var.os_image_url
  format = "qcow2"
}

resource "libvirt_volume" "app" {
  name           = "${var.app_name}-${var.environment}-disk.qcow2"
  pool           = libvirt_pool.app.name
  base_volume_id = libvirt_volume.os.id
  size           = var.disk_gb * 1073741824   # Go → octets
}

resource "libvirt_cloudinit_disk" "init" {
  name      = "${var.app_name}-${var.environment}-init.iso"
  pool      = libvirt_pool.app.name
  user_data = <<-EOF
    #cloud-config
    hostname: ${var.app_name}-${var.environment}
    users:
      - name: {{ appUser }}
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - ${var.ssh_public_key}
    package_update: true
    packages:
      - python3
      - python3-pip
  EOF
}

resource "libvirt_domain" "app" {
  name   = "${var.app_name}-${var.environment}"
  memory = var.ram_mb
  vcpu   = var.cpu_count

  cloudinit = libvirt_cloudinit_disk.init.id

  network_interface {
    network_name   = var.vm_network
    wait_for_lease = true
  }

  disk {
    volume_id = libvirt_volume.app.id
  }

  console {
    type        = "pty"
    target_type = "serial"
    target_port = "0"
  }

  graphics {
    type        = "spice"
    listen_type = "address"
    autoport    = true
  }
}