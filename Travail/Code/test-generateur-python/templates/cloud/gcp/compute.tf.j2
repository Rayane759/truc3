resource "google_compute_instance" "app" {
  name         = "${local.prefix}-vm"
  machine_type = var.instance_type
  zone         = "${var.region}-a"
  tags         = ["${local.prefix}-app"]

  boot_disk {
    initialize_params {
      image = "ubuntu-os-cloud/ubuntu-2204-lts"
      size  = 50
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.public.id
    access_config {}
  }

  metadata_startup_script = <<-EOF
    #!/bin/bash
    apt-get update -y
    apt-get install -y docker.io
    systemctl enable --now docker
  EOF

  labels = {
    app         = var.app_name
    team        = var.team_name
    environment = var.environment
    managed-by  = "golden-path"
  }
}

{% if enableLoadBalancer %}
resource "google_compute_instance_group" "app" {
  name      = "${local.prefix}-ig"
  zone      = "${var.region}-a"
  instances = [google_compute_instance.app.self_link]

  named_port {
    name = "http"
    port = var.app_port
  }
}

resource "google_compute_backend_service" "app" {
  name          = "${local.prefix}-backend"
  protocol      = "HTTP"
  port_name     = "http"
  timeout_sec   = 30

  backend {
    group = google_compute_instance_group.app.self_link
  }

  health_checks = [google_compute_health_check.app.id]
}

resource "google_compute_health_check" "app" {
  name = "${local.prefix}-hc"
  http_health_check {
    port         = var.app_port
    request_path = "/actuator/health"
  }
}

resource "google_compute_url_map" "app" {
  name            = "${local.prefix}-urlmap"
  default_service = google_compute_backend_service.app.id
}

resource "google_compute_global_forwarding_rule" "app" {
  name       = "${local.prefix}-lb"
  target     = google_compute_target_http_proxy.app.id
  port_range = "80"
}

resource "google_compute_target_http_proxy" "app" {
  name    = "${local.prefix}-proxy"
  url_map = google_compute_url_map.app.id
}
{% endif %}