terraform {
  required_version = ">= 1.5.0"

  required_providers {
    {% if cloudProvider == "aws" %}
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    {% elif cloudProvider == "gcp" %}
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
    {% elif cloudProvider == "azure" %}
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
    {% endif %}
  }
}
