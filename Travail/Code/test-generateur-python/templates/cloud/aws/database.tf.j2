{% if enableDatabase %}
resource "aws_db_subnet_group" "app" {
  name       = "${local.prefix}-db-subnet"
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_security_group" "db" {
  name   = "${local.prefix}-db-sg"
  vpc_id = aws_vpc.main.id

  ingress {
    from_port       = {{ "5432" if dbEngine == "postgres" else "3306" }}
    to_port         = {{ "5432" if dbEngine == "postgres" else "3306" }}
    protocol        = "tcp"
    security_groups = [aws_security_group.app.id]
  }
}

resource "aws_db_instance" "app" {
  identifier        = "${local.prefix}-db"
  engine            = "{{ dbEngine }}"
  engine_version    = "{{ dbVersion }}"
  instance_class    = "db.t3.micro"
  allocated_storage = 20
  db_name           = replace(var.app_name, "-", "_")
  username          = var.app_name
  password          = random_password.db.result

  db_subnet_group_name   = aws_db_subnet_group.app.name
  vpc_security_group_ids = [aws_security_group.db.id]
  skip_final_snapshot    = var.environment != "pd"
  deletion_protection    = var.environment == "pd"
}

resource "random_password" "db" {
  length  = 24
  special = false
}
{% endif %}